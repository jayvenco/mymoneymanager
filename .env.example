# Verplicht: lange willekeurige string (genereer met: openssl rand -hex 32)
SECRET_KEY=

TZ=Europe/Amsterdam

# Unraid: nobody:users
PUID=99
PGID=100
UMASK=022

# true wanneer de app achter HTTPS (reverse proxy) draait -> Secure-cookies + HSTS
HTTPS=false

SESSION_LIFETIME_DAYS=7

# Automatische back-ups: frequentie (daily|weekly|monthly), tijdstip (HH:MM) en bewaartermijn in dagen
BACKUP_TIME=03:00
BACKUP_FREQUENCY=monthly
BACKUP_RETENTION_DAYS=360

LOG_LEVEL=INFO
