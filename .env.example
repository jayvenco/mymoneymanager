# Verplicht: lange willekeurige string (genereer met: openssl rand -hex 32)
SECRET_KEY=

TZ=Europe/Amsterdam

# Unraid: nobody:users
PUID=99
PGID=100
UMASK=022

# true wanneer de app achter HTTPS (reverse proxy) draait -> Secure-cookies + HSTS
HTTPS=false

SESSION_LIFETIME_DAYS=7

# Automatische back-ups (HH:MM, lokale tijd) en bewaartermijn
BACKUP_TIME=03:00
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

LOG_LEVEL=INFO
